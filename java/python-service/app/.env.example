# ===== NEURO-AI Python AI 服务环境变量示例 =====
# 复制为 .env 后修改

# 真实模型权重路径（放入 models/ 目录）
MODEL_PATH=models/eeg_model.pt

# 推理设备: cpu / cuda
DEVICE=cpu

# 演示模式: 1=强制演示（返回模拟结果） 0=按模型文件是否存在自动判断
DEMO_MODE=0

# ===== .dat 数据格式 =====
CHANNELS=32
SAMPLE_RATE=128
DAT_DTYPE=float32
# 若真实数据按 [samples, channels] 排列，设为 1
DAT_TRANSPOSE=0
